# Dependencies
node_modules/
server/node_modules/

# Build artifacts
server/dist/
*.tsbuildinfo

# Packed extension (cut a GitHub Release with the .mcpb attached instead)
*.mcpb

# Pulumi stack config (holds deployer-specific domain + encrypted secrets;
# Pulumi.yaml itself stays tracked)
deploy/pulumi/Pulumi.*.yaml

# Per-stack env files (real keys/tokens); only the example is tracked
deploy/pulumi/.env*
!deploy/pulumi/.env.example

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local-only
.local/

# Internal-only memos / share artifacts that should never reach the public repo.
# (e.g., engineering-share memos drafted for specific people, internal context.)
Engineering memo.md
*.internal.md
reference/
support-tickets/
ziVrj0zN

# Deploy-test build output (deploy/pulumi npm test)
deploy/pulumi/bin-test/
