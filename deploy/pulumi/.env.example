# Copy to .env (gitignored) and fill in, then deploy with ./up.sh.

# InsuranceXDate API key. Every request the deployed endpoint serves spends
# this account's balance - treat the deployed URL accordingly.
INSURANCEXDATE_API_KEY=

# Secret path segment for the connector URL (min 16 chars).
# Generate: openssl rand -hex 24
MCP_PATH_TOKEN=

# Custom domain for the endpoint. The DNS zone must live in Cloudflare.
MCP_DOMAIN=mcp.example.com

# Zone apex, if it is not simply the last two labels of MCP_DOMAIN.
# MCP_ZONE_NAME=

# Cloudflare API token scoped to Zone:Read + DNS:Edit on the zone above.
CLOUDFLARE_API_TOKEN=

# AWS credentials/region for App Runner, ECR, and SSM.
# AWS_PROFILE=
AWS_REGION=us-east-1

# Paid tools ($0.05-$0.25/call) are DISABLED by default on a shared
# instance. Uncomment to enable them:
# XDATE_DISABLE_PAID=0

# Stack-state encryption passphrase, if you use a self-managed Pulumi
# backend (pulumi login --local / s3). Not needed with Pulumi Cloud.
# PULUMI_CONFIG_PASSPHRASE=
