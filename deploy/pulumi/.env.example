# Copy to .env (gitignored) and fill in, then deploy with ./up.sh.

# --- Auth mode: fill in EITHER the private-instance pair below OR MCP_BYOK.

# Private instance: one org-wide key, gated by a secret URL.
# InsuranceXDate API key. Every request the deployed endpoint serves spends
# this account's balance - treat the deployed URL accordingly.
INSURANCEXDATE_API_KEY=
# Secret path segment for the connector URL (min 16 chars).
# Generate: openssl rand -hex 24
MCP_PATH_TOKEN=

# Bring-your-own-key service: the server holds no key; each caller sends
# their own per request (Authorization: Bearer, or /mcp/<key> in the URL).
# Incompatible with the two vars above.
# MCP_BYOK=1

# Custom domain for the endpoint. The DNS zone must live in Cloudflare.
MCP_DOMAIN=mcp.example.com

# Zone apex, if it is not simply the last two labels of MCP_DOMAIN.
# MCP_ZONE_NAME=

# Cloudflare API token scoped to Zone:Read + DNS:Edit on the zone above.
CLOUDFLARE_API_TOKEN=

# AWS credentials/region for App Runner, ECR, and SSM.
# AWS_PROFILE=
AWS_REGION=us-east-1

# Paid tools ($0.05-$0.25/call) default by mode: disabled in private mode
# (host's key pays), enabled in BYOK (callers pay their own accounts).
# Set explicitly to override: truthy (1/true/yes/on) disables, falsy enables.
# XDATE_DISABLE_PAID=1

# Pulumi stack this env file deploys; up.sh auto-selects (and creates) it,
# so one file's values can never land in another file's stack.
# MCP_STACK=prod

# Physical App Runner service name; MUST differ per stack when running
# several endpoints in one AWS account (e.g. private + BYOK).
# MCP_SERVICE_NAME=insurancexdate-mcp

# Per-credential rate limit (caller's key in BYOK, the path token in
# private mode), JSON-RPC requests/minute — a batch of N counts as N.
# Server default applies if unset; 0 disables; a non-numeric value refuses
# to start.
# MCP_RATE_LIMIT_PER_MIN=60

# BYOK only: host-wide backstop across ALL keys, requests/minute (defaults
# to 10x the per-key limit; 0 disables).
# MCP_GLOBAL_RATE_LIMIT_PER_MIN=600

# Max App Runner instances (default 1 — caps what a request flood can cost;
# also multiplies the per-process rate limits). Raise only with intent.
# MCP_MAX_INSTANCES=1

# If set, creates an ACCOUNT-wide AWS monthly cost budget that emails this
# address at 80% actual / 100% forecasted spend.
# MCP_BILLING_ALERT_EMAIL=
# Budget amount in USD (default 50). Only read when the email is set.
# MCP_MONTHLY_BUDGET_USD=50

# Stack-state encryption passphrase, if you use a self-managed Pulumi
# backend (pulumi login --local / s3). Not needed with Pulumi Cloud.
# PULUMI_CONFIG_PASSPHRASE=
